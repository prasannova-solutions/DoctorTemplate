---
// src/pages/blog/[slug].astro - Full Blog Article Page
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { blogPosts, type BlogPost } from "../../data/blogPosts";

export async function getStaticPaths() {
    return blogPosts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

interface Props {
    post: BlogPost;
}

const { post } = Astro.props;

// Related posts (excluding current post)
const relatedPosts = blogPosts.filter((p) => p.slug !== post.slug).slice(0, 3);
---

<Layout
    title={`${post.title} | Dr. Deepali Patil, MD, FACP`}
    description={post.excerpt}
>
    <Navbar brandName="Dr. Deepali Patil" designation="MD, FACP" />

    <main class="pt-28 pb-20 px-4">
        <article class="mx-auto max-w-4xl">
            
            <!-- Breadcrumbs -->
            <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-6 flex-wrap" aria-label="Breadcrumb">
                <a href="/" class="hover:text-sky-600 transition-colors">Home</a>
                <span>/</span>
                <a href="/blog" class="hover:text-sky-600 transition-colors">Medical Blog</a>
                <span>/</span>
                <span class="text-sky-700 truncate max-w-[280px] sm:max-w-md">{post.category}</span>
            </nav>

            <!-- Article Header -->
            <header class="mb-8">
                <div class="flex items-center gap-2.5 flex-wrap mb-4">
                    <span class="text-xs font-bold px-3 py-1 rounded-full bg-sky-100 text-sky-800 uppercase tracking-wider">
                        {post.category}
                    </span>
                    <span class="text-xs font-medium text-slate-500">
                        • {post.readTime}
                    </span>
                    <span class="text-xs font-medium text-slate-500">
                        • Published on {post.publishedDate}
                    </span>
                </div>

                <h1 class="text-3xl sm:text-4xl lg:text-[42px] font-extrabold text-slate-900 tracking-tight leading-[1.2]">
                    {post.title}
                </h1>

                <p class="mt-4 text-lg text-slate-600 leading-relaxed font-normal">
                    {post.subtitle}
                </p>

                <!-- Author Bar -->
                <div class="mt-6 flex items-center justify-between p-4 rounded-2xl bg-white border border-slate-200/80 elevation-2">
                    <div class="flex items-center gap-3">
                        <img
                            src={post.author.avatar}
                            alt={post.author.name}
                            class="w-12 h-12 rounded-full object-cover object-top border-2 border-sky-300 bg-sky-50 shadow-xs"
                        />
                        <div>
                            <p class="text-sm font-bold text-slate-900 leading-tight">
                                Written by {post.author.name}, MD, FACP
                            </p>
                            <p class="text-xs text-sky-600 font-medium mt-0.5">
                                Senior Consultant Physician • Internal & Preventive Medicine
                            </p>
                        </div>
                    </div>

                    <a
                        href="/#appointment"
                        class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold btn-elevated-primary transition-all"
                    >
                        Book Consultation
                    </a>
                </div>
            </header>

            <!-- Hero Cover Image -->
            <div class="relative rounded-3xl overflow-hidden shadow-2xl mb-10 border-4 border-white aspect-[16/9] bg-slate-100">
                <img
                    src={post.image}
                    alt={post.title}
                    class="w-full h-full object-cover"
                    loading="eager"
                    width="1200"
                    height="675"
                />
            </div>

            <!-- Key Clinical Takeaways Callout Card -->
            <div class="mb-10 rounded-2xl glass-panel-elevated elevation-6 p-6 sm:p-7 bg-gradient-to-br from-sky-50/90 via-teal-50/40 to-white/95 border border-sky-100">
                <div class="flex items-center gap-2 text-sky-800 text-sm font-bold uppercase tracking-wider mb-3">
                    <div class="w-6 h-6 rounded-lg bg-sky-600 text-white flex items-center justify-center shadow-xs">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                    </div>
                    Clinical Key Takeaways
                </div>

                <ul class="space-y-2.5">
                    {
                        post.keyTakeaways.map((takeaway) => (
                            <li class="text-sm text-slate-700 flex items-start gap-2.5 leading-relaxed">
                                <span class="text-emerald-500 font-bold mt-0.5">✓</span>
                                <span>{takeaway}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Article Sections Body -->
            <div class="space-y-10 prose prose-slate max-w-none">
                {
                    post.sections.map((sec, idx) => (
                        <section class="p-6 sm:p-8 rounded-3xl bg-white border border-slate-100 elevation-2">
                            <div class="flex items-center gap-2 mb-4">
                                <span class="text-xs font-bold px-2 py-0.5 rounded-md bg-sky-100 text-sky-800 font-mono">
                                    0{idx + 1}
                                </span>
                                <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight m-0">
                                    {sec.heading}
                                </h2>
                            </div>

                            <div class="space-y-4 text-base text-slate-700 leading-relaxed">
                                {
                                    sec.paragraphs.map((p) => (
                                        <p>{p}</p>
                                    ))
                                }
                            </div>
                        </section>
                    ))
                }
            </div>

            <!-- Article Tags -->
            <div class="mt-8 pt-6 border-t border-slate-200 flex items-center justify-between flex-wrap gap-3">
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-xs font-bold text-slate-500">Tags:</span>
                    {
                        post.tags.map((tag) => (
                            <span class="text-xs px-3 py-1 rounded-full bg-slate-100 text-slate-700 font-medium border border-slate-200">
                                #{tag}
                            </span>
                        ))
                    }
                </div>

                <a
                    href="/blog"
                    class="text-xs font-bold text-sky-600 hover:text-sky-800 inline-flex items-center gap-1"
                >
                    ← Back to All Articles
                </a>
            </div>

            <!-- Author Bio Card -->
            <div class="mt-12 rounded-3xl glass-panel-elevated elevation-8 p-6 sm:p-8 bg-gradient-to-br from-white/95 to-sky-50/70 border border-white flex flex-col sm:flex-row items-center sm:items-start gap-6">
                <img
                    src={post.author.avatar}
                    alt={post.author.name}
                    class="w-24 h-24 rounded-2xl object-cover object-top border-2 border-white shadow-md bg-sky-100 flex-shrink-0"
                />
                <div class="text-center sm:text-left">
                    <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-sky-100 text-sky-800 text-[10px] font-bold uppercase tracking-wider mb-2">
                        About The Author
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 leading-tight">
                        {post.author.name}, MD, FACP
                    </h3>
                    <p class="text-xs font-semibold text-sky-600 mt-0.5">
                        Fellow of the American College of Physicians • 18+ Years Clinical Practice
                    </p>
                    <p class="mt-2 text-xs text-slate-600 leading-relaxed">
                        Dr. Deepali Patil provides unhurried, whole-person care following the collaborative medical model inspired by premier institutions. Specializing in cardiometabolic optimization, hypertension, diabetes reversal, and longevity assessments.
                    </p>
                    <div class="mt-4 flex items-center justify-center sm:justify-start gap-3">
                        <a
                            href="/#appointment"
                            class="px-5 py-2.5 rounded-full bg-sky-600 hover:bg-sky-700 text-white font-bold text-xs btn-elevated-primary transition-all"
                        >
                            Schedule Consultation with Dr. Patil
                        </a>
                        <a
                            href="/#about"
                            class="px-4 py-2.5 rounded-full bg-white text-slate-700 font-semibold text-xs border border-slate-200 glass-pill"
                        >
                            Physician Profile
                        </a>
                    </div>
                </div>
            </div>

            <!-- Related Articles -->
            {
                relatedPosts.length > 0 && (
                    <section class="mt-16 pt-10 border-t border-slate-200">
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="text-xl font-bold text-slate-900 tracking-tight">
                                Related Medical Guides
                            </h3>
                            <a href="/blog" class="text-xs font-bold text-sky-600 hover:text-sky-800">
                                View all →
                            </a>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            {
                                relatedPosts.map((rel) => (
                                    <a
                                        href={`/blog/${rel.slug}`}
                                        class="group rounded-2xl elevated-card overflow-hidden flex flex-col justify-between bg-white p-4 transition-all hover:elevation-6 hover:-translate-y-0.5"
                                    >
                                        <div>
                                            <div class="relative h-28 w-full rounded-xl overflow-hidden mb-3 bg-slate-100">
                                                <img
                                                    src={rel.image}
                                                    alt={rel.title}
                                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                                    loading="lazy"
                                                />
                                            </div>
                                            <span class="text-[10px] font-bold text-sky-700 uppercase tracking-wider block mb-1">
                                                {rel.category}
                                            </span>
                                            <h4 class="text-xs font-bold text-slate-900 group-hover:text-sky-600 transition-colors line-clamp-2 leading-snug">
                                                {rel.title}
                                            </h4>
                                        </div>
                                        <div class="mt-3 pt-2 border-t border-slate-100 flex items-center justify-between text-[10px] text-slate-500 font-medium">
                                            <span>{rel.readTime}</span>
                                            <span class="text-sky-600 font-bold group-hover:translate-x-0.5 transition-transform">Read →</span>
                                        </div>
                                    </a>
                                ))
                            }
                        </div>
                    </section>
                )
            }

        </article>
    </main>

    <Footer />
</Layout>

