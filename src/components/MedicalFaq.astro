---
// MedicalFaq.astro - Mayo Clinic-inspired Patient Care FAQ
const faqs = [
    {
        q: "What medical records should I bring for my first consultation?",
        a: "Please bring any previous blood test results, ECG/radiology imaging from the past 12 months, a complete list of your current prescriptions and over-the-counter supplements, and any recent hospital discharge summaries. This helps Dr. Patil evaluate your baseline health without redundant tests.",
        category: "Preparation",
    },
    {
        q: "Do I need a prior referral to see Dr. Deepali Patil?",
        a: "No formal referral is required. You can schedule a direct consultation for general health assessments, chronic condition management, or acute concerns. However, if you were referred by another physician, bringing their clinical notes is welcome.",
        category: "Appointments",
    },
    {
        q: "How does Dr. Patil handle second medical opinions?",
        a: "For complex cardiometabolic diagnoses or unresolved symptoms, Dr. Patil conducts a comprehensive 45-minute case audit. She systematically reviews past scans, laboratory records, and clinical histories to deliver an objective, evidence-based second opinion report.",
        category: "Second Opinion",
    },
    {
        q: "Are video telehealth consultations available for outstation patients?",
        a: "Yes. Dr. Patil offers secure HIPAA-compliant video consultations for routine follow-ups, continuous glucose monitoring reviews, and second opinions for patients residing outside Pune or unable to travel.",
        category: "Telehealth",
    },
    {
        q: "How fast are diagnostic laboratory and screening results delivered?",
        a: "Standard metabolic panels, lipid profiles, and HbA1c tests processed through our accredited lab are generally ready within 4 to 8 hours. Comprehensive endocrine and biomarker panels are delivered within 24 to 48 hours directly to your patient portal.",
        category: "Diagnostics",
    },
    {
        q: "Which health insurance providers and cashless networks are accepted?",
        a: "Our clinic is partnered with major Third-Party Administrators (TPAs) and leading insurance carriers including Star Health, HDFC ERGO, ICICI Lombard, Niva Bupa, and Care Health for outpatient wellness reimbursement and cashless hospital coordination.",
        category: "Insurance",
    },
];
---

<!-- ================= DESKTOP FAQ SECTION ================= -->
<section id="faq" class="hidden md:block w-full px-4 py-16 bg-slate-50">
    <div class="mx-auto max-w-[1340px]">
        <!-- Header -->
        <div class="text-center max-w-3xl mx-auto mb-12">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-100 text-sky-800 text-xs font-bold uppercase tracking-wider mb-3">
                <span class="w-2 h-2 rounded-full bg-sky-600"></span>
                Patient Resources & FAQs
            </div>
            <h2 class="text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
                Frequently Asked Questions
            </h2>
            <p class="mt-3 text-slate-600 text-base leading-relaxed">
                Everything you need to know about scheduling, clinical evaluations, and diagnostic care at Dr. Deepali Patil's practice.
            </p>
        </div>

        <!-- 2 Column FAQ Grid -->
        <div class="grid grid-cols-2 gap-6">
            {
                faqs.map((faq, i) => (
                    <details class="group rounded-3xl elevated-card p-6 [&_summary::-webkit-details-marker]:hidden" open={i === 0}>
                        <summary class="flex items-center justify-between cursor-pointer font-bold text-base text-slate-900 list-none group-hover:text-sky-700">
                            <span class="flex items-center gap-3">
                                <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-sky-50 text-sky-700">
                                    {faq.category}
                                </span>
                                <span>{faq.q}</span>
                            </span>
                            <span class="ml-4 flex-shrink-0 w-8 h-8 rounded-full bg-slate-100 group-open:bg-sky-600 group-open:text-white flex items-center justify-center transition-colors">
                                <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                                </svg>
                            </span>
                        </summary>
                        <p class="mt-4 text-sm text-slate-600 leading-relaxed pl-1 pt-2 border-t border-slate-100">
                            {faq.a}
                        </p>
                    </details>
                ))
            }
        </div>
    </div>
</section>

<!-- ================= MOBILE FAQ SECTION ================= -->
<section class="block md:hidden px-3 py-10 bg-slate-50">
    <div class="mb-5">
        <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-sky-100 text-sky-800 text-[10px] font-bold uppercase tracking-wider mb-2">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-600"></span>
            Patient FAQ
        </div>
        <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight leading-tight">
            Common Patient <br /><span class="text-sky-600">Questions</span>
        </h2>
    </div>

    <div class="space-y-2.5">
        {
            faqs.map((faq, i) => (
                <details class="group rounded-2xl glass-panel elevation-2 p-3.5 [&_summary::-webkit-details-marker]:hidden" open={i === 0}>
                    <summary class="flex items-start justify-between cursor-pointer font-bold text-xs text-slate-900 list-none">
                        <span class="pr-2">{faq.q}</span>
                        <span class="w-5 h-5 flex-shrink-0 rounded-full bg-slate-100 flex items-center justify-center group-open:rotate-180 transition-transform">
                            <svg class="w-3 h-3 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                            </svg>
                        </span>
                    </summary>
                    <p class="mt-2.5 pt-2 border-t border-slate-100 text-[11px] text-slate-600 leading-relaxed">
                        {faq.a}
                    </p>
                </details>
            ))
        }
    </div>
</section>

