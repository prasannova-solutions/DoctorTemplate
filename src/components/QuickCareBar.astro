---
// QuickCareBar.astro - Inspired by Mayo Clinic's top action triage bar
const quickActions = [
    {
        icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />`,
        title: "Request Appointment",
        desc: "Schedule with Dr. Patil online",
        badge: "Fast Track",
        href: "#appointment",
        primary: true,
    },
    {
        icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />`,
        title: "Find a Treatment",
        desc: "Specialized clinical care",
        badge: "6 Specialties",
        href: "#specialties",
        primary: false,
    },
    {
        icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />`,
        title: "Second Medical Opinion",
        desc: "Confidential case reviews",
        badge: "Expert Review",
        href: "#appointment",
        primary: false,
    },
    {
        icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />`,
        title: "Telehealth & Video Care",
        desc: "Virtual consultations at home",
        badge: "Virtual Clinic",
        href: "#appointment",
        primary: false,
    },
];

const popularConditions = [
    "Type 2 Diabetes",
    "Hypertension",
    "Thyroid Disorders",
    "Executive Health Check",
    "Preventive Cardiology",
    "Chronic Fatigue",
];
---

<!-- DESKTOP QUICK CARE BAR (hidden on mobile, block on md+) -->
<section class="hidden md:block w-full px-3 py-6 -mt-8 relative z-30">
    <div class="mx-auto max-w-[1340px]">
        <div class="glass-panel-elevated rounded-3xl p-6">
            <!-- 4 Column Quick Actions -->
            <div class="grid grid-cols-4 gap-4">
                {
                    quickActions.map((action) => (
                        <a
                            href={action.href}
                            class={`group relative p-5 rounded-2xl border transition-transform duration-200 flex flex-col justify-between ${
                                action.primary
                                    ? "bg-gradient-to-br from-sky-600 to-sky-700 text-white border-sky-500 shadow-sm hover:shadow-md hover:-translate-y-1"
                                    : "bg-white/85 hover:bg-white text-slate-900 border-white/90 shadow-xs hover:shadow-md hover:-translate-y-1"
                            }`}
                        >
                            <div class="flex items-start justify-between">
                                <div class={`w-11 h-11 rounded-xl flex items-center justify-center transition-transform group-hover:scale-105 ${
                                    action.primary ? "bg-white/20 text-white" : "bg-sky-50 text-sky-600 group-hover:bg-sky-100"
                                }`}>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" set:html={action.icon} />
                                </div>
                                <span class={`text-[11px] font-semibold px-2.5 py-0.5 rounded-full ${
                                    action.primary ? "bg-white/25 text-white" : "bg-sky-100 text-sky-700"
                                }`}>
                                    {action.badge}
                                </span>
                            </div>

                            <div class="mt-4">
                                <h3 class={`text-base font-bold tracking-tight ${action.primary ? "text-white" : "text-slate-900 group-hover:text-sky-700"}`}>
                                    {action.title}
                                </h3>
                                <p class={`mt-1 text-xs ${action.primary ? "text-sky-100" : "text-slate-500"}`}>
                                    {action.desc}
                                </p>
                            </div>

                            <div class="mt-3 flex items-center gap-1 text-xs font-semibold">
                                <span class={action.primary ? "text-white" : "text-sky-600"}>Access Service</span>
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7m0 0l-7 7" />
                                </svg>
                            </div>
                        </a>
                    ))
                }
            </div>

            <!-- Popular Care Searches Ticker (Mayo Clinic Style) -->
            <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-2 text-xs font-semibold text-slate-500">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                    <span>Frequent Clinical Consultations:</span>
                </div>
                <div class="flex items-center gap-2 flex-wrap">
                    {
                        popularConditions.map((condition) => (
                            <a
                                href="#specialties"
                                class="text-xs px-3 py-1 rounded-full bg-slate-100 hover:bg-sky-50 text-slate-700 hover:text-sky-700 border border-slate-200 hover:border-sky-200 transition-colors"
                            >
                                {condition}
                            </a>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- MOBILE QUICK CARE BAR (block on mobile, hidden on md+) -->
<section class="block md:hidden px-2 py-4">
    <div class="glass-panel-elevated rounded-2xl p-3.5">
        <div class="flex items-center justify-between mb-3 px-1">
            <span class="text-xs font-bold text-slate-800 uppercase tracking-wider">Direct Patient Access</span>
            <span class="text-[10px] font-medium text-sky-700">Mayo Model Care</span>
        </div>

        <!-- 2x2 Grid for Mobile Touch -->
        <div class="grid grid-cols-2 gap-2">
            {
                quickActions.map((action) => (
                    <a
                        href={action.href}
                        class={`p-3 rounded-xl border flex flex-col justify-between transition-colors ${
                            action.primary
                                ? "bg-sky-600 text-white border-sky-500 shadow-xs"
                                : "bg-white/90 text-slate-800 border-slate-200/90 shadow-xs active:bg-sky-50"
                        }`}
                    >
                        <div class="flex items-center justify-between mb-2">
                            <div class={`w-7 h-7 rounded-lg flex items-center justify-center ${
                                action.primary ? "bg-white/20 text-white" : "bg-sky-50 text-sky-600"
                            }`}>
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" set:html={action.icon} />
                            </div>
                            <span class={`text-[9px] font-bold px-1.5 py-0.5 rounded ${
                                action.primary ? "bg-white/25 text-white" : "bg-sky-100 text-sky-700"
                            }`}>
                                {action.badge}
                            </span>
                        </div>
                        <h4 class={`text-xs font-bold leading-tight ${action.primary ? "text-white" : "text-slate-900"}`}>
                            {action.title}
                        </h4>
                        <p class={`mt-0.5 text-[10px] line-clamp-1 ${action.primary ? "text-sky-100" : "text-slate-500"}`}>
                            {action.desc}
                        </p>
                    </a>
                ))
            }
        </div>

        <!-- Horizontal scrollable condition chips -->
        <div class="mt-3 pt-2.5 border-t border-slate-100 flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-1">
            <span class="text-[10px] font-bold text-slate-400 whitespace-nowrap">Common:</span>
            {
                popularConditions.slice(0, 4).map((cond) => (
                    <a
                        href="#specialties"
                        class="text-[10px] font-medium px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600 whitespace-nowrap active:bg-sky-100 active:text-sky-800"
                    >
                        {cond}
                    </a>
                ))
            }
        </div>
    </div>
</section>

