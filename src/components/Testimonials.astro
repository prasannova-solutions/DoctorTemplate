---
// Testimonials.astro - Patient Reviews & Clinical Outcomes
const stories = [
    {
        name: "Rajesh K.",
        age: "52 yrs",
        profession: "Corporate Director",
        condition: "Type 2 Diabetes & Hypertension",
        outcome: "HbA1c reduced from 9.4% to 6.1%",
        quote: "Dr. Deepali Patil completely transformed my diabetes care. Instead of just adding more prescriptions, she analyzed my metabolic markers, revamped my dietary timing, and helped me safely reduce my medications. Her clinical depth is unmatched.",
        rating: 5,
        badge: "Verified Patient",
    },
    {
        name: "Sunita M.",
        age: "46 yrs",
        profession: "Senior Educator",
        condition: "Thyroid Disorder & Chronic Fatigue",
        outcome: "Normalized TSH & full vitality restored",
        quote: "For years I was told my exhaustion was simply stress. Dr. Patil was the first physician who truly listened, did targeted endocrine testing, and diagnosed subclinical Hashimoto's. Within 8 weeks under her plan, I felt like myself again.",
        rating: 5,
        badge: "Verified Patient",
    },
    {
        name: "Vikramaditya S.",
        age: "64 yrs",
        profession: "Retired Civil Officer",
        condition: "Preventive Cardiology & Lipid Care",
        outcome: "Arterial inflammation markers normalized",
        quote: "With severe heart disease in my family, I needed a physician who practices true preventive medicine. Dr. Patil’s comprehensive risk evaluation and meticulous follow-up gave my entire family peace of mind.",
        rating: 5,
        badge: "Verified Patient",
    },
    {
        name: "Pooja N.",
        age: "38 yrs",
        profession: "Technology Architect",
        condition: "Executive Wellness & Hormonal Balance",
        outcome: "Custom longevity & metabolic profile",
        quote: "The Mayo Clinic level of clinical thoroughness right here! The initial 45-minute consultation was completely unhurried. Dr. Patil connects the dots between sleep, nutrition, and blood biomarkers seamlessly.",
        rating: 5,
        badge: "Verified Patient",
    },
];
---

<!-- ================= DESKTOP TESTIMONIALS ================= -->
<section id="testimonials" class="hidden md:block w-full px-4 py-16 bg-gradient-to-b from-transparent via-slate-100/60 to-transparent">
    <div class="mx-auto max-w-[1340px]">
        <!-- Section Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
            <div class="max-w-2xl">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-100 text-sky-800 text-xs font-bold uppercase tracking-wider mb-3">
                    <span class="w-2 h-2 rounded-full bg-sky-600"></span>
                    Patient Experiences & Outcomes
                </div>
                <h2 class="text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
                    Real Health Transformations, <br />
                    <span class="text-sky-600">Driven by Dedicated Medical Care</span>
                </h2>
                <p class="mt-3 text-slate-600 text-base">
                    Read how patients with complex chronic illnesses and preventive wellness goals regained vitality through Dr. Deepali Patil's evidence-based clinical protocols.
                </p>
            </div>

            <div class="flex items-center gap-2 bg-white/80 backdrop-blur-md px-5 py-3 rounded-2xl border border-slate-200 shadow-sm">
                <div class="flex text-amber-400">
                    {Array.from({ length: 5 }).map(() => (
                        <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                    ))}
                </div>
                <span class="text-sm font-bold text-slate-800 ml-1">4.9 / 5.0</span>
                <span class="text-xs text-slate-500">(1,200+ Patient Reviews)</span>
            </div>
        </div>

        <!-- 4 Grid Cards -->
        <div class="grid grid-cols-2 gap-6">
            {
                stories.map((story) => (
                    <div class="rounded-3xl elevated-card p-7 flex flex-col justify-between">
                        <div>
                            <!-- Header: Patient name & Rating -->
                            <div class="flex items-center justify-between mb-4">
                                <div>
                                    <h3 class="text-base font-bold text-slate-900">{story.name}</h3>
                                    <p class="text-xs text-slate-500 font-medium">{story.age} • {story.profession}</p>
                                </div>
                                <span class="text-[11px] font-bold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200/60 flex items-center gap-1">
                                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                    </svg>
                                    {story.badge}
                                </span>
                            </div>

                            <!-- Star Rating -->
                            <div class="flex text-amber-400 mb-3">
                                {Array.from({ length: story.rating }).map(() => (
                                    <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                    </svg>
                                ))}
                            </div>

                            <!-- Quote -->
                            <p class="text-sm text-slate-700 leading-relaxed italic">
                                "{story.quote}"
                            </p>
                        </div>

                        <!-- Clinical Result Footer -->
                        <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
                            <div>
                                <span class="text-slate-400 font-semibold block text-[10px] uppercase tracking-wider">Condition:</span>
                                <span class="font-bold text-slate-800">{story.condition}</span>
                            </div>
                            <div class="text-right">
                                <span class="text-sky-600 font-semibold block text-[10px] uppercase tracking-wider">Outcome:</span>
                                <span class="font-extrabold text-teal-700">{story.outcome}</span>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<!-- ================= MOBILE TESTIMONIALS ================= -->
<section class="block md:hidden px-3 py-10">
    <div class="mb-5">
        <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-sky-100 text-sky-800 text-[10px] font-bold uppercase tracking-wider mb-2">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-600"></span>
            Patient Stories
        </div>
        <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight leading-tight">
            Patient Outcomes with <br /><span class="text-sky-600">Dr. Deepali Patil</span>
        </h2>
        <div class="flex items-center gap-1 mt-1 text-xs text-amber-500 font-bold">
            <span>★★★★★</span>
            <span class="text-slate-700 font-medium">4.9 / 5.0 Verified Rating</span>
        </div>
    </div>

    <!-- Mobile Stacked Reviews -->
    <div class="flex flex-col gap-3">
        {
            stories.map((story) => (
                <div class="rounded-2xl glass-panel elevation-2 p-4">
                    <div class="flex items-center justify-between mb-2">
                        <div>
                            <h4 class="text-xs font-bold text-slate-900">{story.name}</h4>
                            <p class="text-[10px] text-slate-500">{story.condition}</p>
                        </div>
                        <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700">
                            Verified
                        </span>
                    </div>

                    <p class="text-xs text-slate-700 italic leading-snug">
                        "{story.quote}"
                    </p>

                    <div class="mt-2.5 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px]">
                        <span class="text-sky-700 font-bold">{story.outcome}</span>
                    </div>
                </div>
            ))
        }
    </div>
</section>

