---
// AppointmentSection.astro - Consultation Booking & Clinic Contact
const specialties = [
    "Internal & Preventive Medicine",
    "Diabetes & Metabolic Health",
    "Cardiovascular & Lipid Care",
    "Women's Health & Hormones",
    "Pulmonology & Respiratory Care",
    "Executive Full-Body Health Check",
    "Second Medical Opinion",
];

const insurancePartners = [
    "Star Health",
    "HDFC ERGO",
    "ICICI Lombard",
    "Care Health",
    "Max Bupa / Niva Bupa",
    "Corporate & TPA Panels",
];
---

<!-- ================= DESKTOP APPOINTMENT & CLINIC SECTION ================= -->
<section id="appointment" class="hidden md:block w-full px-4 py-16">
    <div class="mx-auto max-w-[1340px]">
        <!-- Section Header -->
        <div class="max-w-2xl mb-12">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-100 text-sky-800 text-xs font-bold uppercase tracking-wider mb-3">
                <span class="w-2 h-2 rounded-full bg-sky-600 animate-pulse"></span>
                Book Your Consultation
            </div>
            <h2 class="text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
                Schedule an Appointment with <br />
                <span class="text-sky-600">Dr. Deepali Patil, MD</span>
            </h2>
            <p class="mt-3 text-slate-600 text-base leading-relaxed">
                Choose in-clinic consultation at our modern facility or connect from home via secure video telehealth. Our medical coordinator will confirm your preferred time slot.
            </p>
        </div>

        <div class="grid grid-cols-12 gap-8 items-start">
            
            <!-- Booking Form Card (7 Cols) -->
            <div class="col-span-7 glass-panel-elevated elevation-8 rounded-3xl p-8 transition-all">
                <div class="flex items-center justify-between pb-5 border-b border-slate-100 mb-6">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900">Patient Consultation Form</h3>
                        <p class="text-xs text-slate-500">Confidential & HIPAA compliant health booking</p>
                    </div>
                    <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold border border-emerald-100 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Slots Open This Week
                    </span>
                </div>

                <form id="desktop-appointment-form" class="space-y-4">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Full Name *</label>
                            <input
                                type="text"
                                required
                                placeholder="e.g. Ramesh Kulkarni"
                                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 focus:bg-white transition-all"
                            />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Phone Number *</label>
                            <input
                                type="tel"
                                required
                                placeholder="+91 98220 XXXXX"
                                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 focus:bg-white transition-all"
                            />
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Email Address</label>
                            <input
                                type="email"
                                placeholder="name@example.com"
                                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 focus:bg-white transition-all"
                            />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Consultation Type *</label>
                            <select class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 focus:bg-white transition-all">
                                <option value="clinic">In-Clinic Consultation (Pune)</option>
                                <option value="telehealth">Telehealth / Video Consultation</option>
                                <option value="opinion">Second Medical Opinion</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Clinical Specialty *</label>
                            <select class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 focus:bg-white transition-all">
                                {
                                    specialties.map((spec) => (
                                        <option value={spec}>{spec}</option>
                                    ))
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Preferred Date</label>
                            <input
                                type="date"
                                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 focus:bg-white transition-all"
                            />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Brief Symptoms or Notes (Optional)</label>
                        <textarea
                            rows="2"
                            placeholder="Describe any symptoms, previous diagnoses, or recent lab reports you will bring..."
                            class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 focus:bg-white transition-all resize-none"
                        ></textarea>
                    </div>

                    <button
                        type="submit"
                        class="w-full py-4 rounded-xl bg-sky-600 hover:bg-sky-700 active:scale-[0.99] text-white font-bold text-sm elevation-4 hover:elevation-8 hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center justify-center gap-2"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        Confirm & Request Consultation
                    </button>

                    <p class="text-[11px] text-slate-500 text-center">
                        Our patient coordinator will contact you via phone/WhatsApp within 2 hours to confirm your timing.
                    </p>
                </form>

                <div id="desktop-success-message" class="hidden p-6 rounded-2xl bg-emerald-50 border border-emerald-200 text-center">
                    <div class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-600 mx-auto flex items-center justify-center mb-3">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <h4 class="text-base font-bold text-emerald-900">Consultation Request Received!</h4>
                    <p class="text-xs text-emerald-700 mt-1 max-w-md mx-auto">
                        Thank you for reaching out to Dr. Deepali Patil's clinic. Our clinical team has received your details and will call you shortly to confirm your consultation schedule.
                    </p>
                </div>
            </div>

            <!-- Clinic Contact & Hours Card (5 Cols) -->
            <div class="col-span-5 space-y-6">
                <!-- Location & Contact -->
                <div class="glass-panel-elevated elevation-8 rounded-3xl p-7 hover:elevation-12 transition-all">
                    <h3 class="text-base font-bold text-slate-900 mb-4 flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        Clinic Location & Contact
                    </h3>

                    <p class="text-sm font-semibold text-slate-800">Patil Healthcare & Specialty Medical Center</p>
                    <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                        Suite 402, 4th Floor, Metro Health Tower, North Main Road, Koregaon Park, Pune, MH 411001
                    </p>

                    <div class="mt-4 pt-4 border-t border-slate-100 space-y-2.5 text-xs">
                        <div class="flex items-center justify-between">
                            <span class="text-slate-500 font-medium">Clinic Helpline:</span>
                            <a href="tel:+912026128800" class="font-bold text-sky-700 hover:underline">(020) 2612-8800</a>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-slate-500 font-medium">Direct Mobile / WhatsApp:</span>
                            <a href="tel:+919822012345" class="font-bold text-sky-700 hover:underline">+91 98220 12345</a>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-slate-500 font-medium">Email Enquiries:</span>
                            <a href="mailto:care@drdeepalipatil.com" class="font-bold text-slate-700 hover:underline">care@drdeepalipatil.com</a>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-t border-slate-100">
                        <a
                            href="#location"
                            class="w-full py-2 px-3 rounded-xl bg-sky-50 hover:bg-sky-100 text-sky-800 font-bold text-xs flex items-center justify-center gap-1.5 transition-colors border border-sky-200/60"
                        >
                            <span>📍 View Clinic on Google Map & Transit</span>
                            <span>→</span>
                        </a>
                    </div>
                </div>

                <!-- Clinic Hours & Emergency Card -->
                <div class="bg-gradient-to-br from-sky-900 to-slate-900 text-white rounded-3xl p-7 elevation-8 hover:elevation-12 transition-all">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-base font-bold flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            Consultation Hours
                        </h3>
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-sky-500/30 text-sky-200">
                            By Appointment
                        </span>
                    </div>

                    <div class="space-y-2 text-xs">
                        <div class="flex justify-between py-1 border-b border-white/10">
                            <span class="text-sky-200">Monday – Friday:</span>
                            <span class="font-bold">8:30 AM – 7:30 PM</span>
                        </div>
                        <div class="flex justify-between py-1 border-b border-white/10">
                            <span class="text-sky-200">Saturday:</span>
                            <span class="font-bold">9:00 AM – 4:30 PM</span>
                        </div>
                        <div class="flex justify-between py-1 border-b border-white/10">
                            <span class="text-sky-200">Sunday:</span>
                            <span class="font-bold text-amber-300">Emergency & Urgent Care Only</span>
                        </div>
                    </div>

                    <!-- 24/7 Helpline -->
                    <div class="mt-5 p-3.5 rounded-2xl bg-white/10 border border-white/10 flex items-center justify-between">
                        <div>
                            <span class="text-[10px] font-semibold text-sky-300 uppercase tracking-wider block">24/7 Acute Medical Emergency:</span>
                            <span class="font-black text-sm text-white">+91 98220 99999</span>
                        </div>
                        <a href="tel:+919822099999" class="px-3 py-1.5 rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold text-xs">
                            Call Emergency
                        </a>
                    </div>
                </div>

                <!-- Insurance & Cashless Card -->
                <div class="glass-panel elevation-4 rounded-2xl p-4 text-xs">
                    <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block mb-2">Accepted Insurance & TPA Networks:</span>
                    <div class="flex flex-wrap gap-1.5">
                        {
                            insurancePartners.map((partner) => (
                                <span class="px-2.5 py-1 rounded-md bg-slate-100 text-slate-700 font-medium">
                                    {partner}
                                </span>
                            ))
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ================= MOBILE APPOINTMENT & CONTACT ================= -->
<section id="mobile-appointment" class="block md:hidden px-3 py-10">
    <div class="mb-5">
        <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-sky-100 text-sky-800 text-[10px] font-bold uppercase tracking-wider mb-2">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-600"></span>
            Direct Booking
        </div>
        <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight leading-tight">
            Book With <span class="text-sky-600">Dr. Patil</span>
        </h2>
        <p class="mt-1 text-xs text-slate-600">
            Select your preferred consultation format below.
        </p>
    </div>

    <!-- Quick Call Banner for Mobile -->
    <div class="mb-4 p-3 rounded-2xl bg-sky-600 text-white flex items-center justify-between elevation-4">
        <div>
            <span class="text-[10px] uppercase font-bold text-sky-200 block">Instant Phone Booking</span>
            <span class="font-extrabold text-xs">(020) 2612-8800</span>
        </div>
        <a
            href="tel:+912026128800"
            class="px-3.5 py-1.5 rounded-xl bg-white text-sky-700 font-bold text-xs"
        >
            Call Now
        </a>
    </div>

    <!-- Mobile Appointment Form -->
    <div class="rounded-2xl glass-panel-elevated elevation-6 p-4 mb-4">
        <h3 class="text-sm font-bold text-slate-900 mb-3 pb-2 border-b border-slate-100">
            Online Consultation Request
        </h3>

        <form id="mobile-appointment-form" class="space-y-3 text-xs">
            <div>
                <label class="block font-bold text-slate-700 mb-1">Your Name *</label>
                <input
                    type="text"
                    required
                    placeholder="e.g. Ramesh Kulkarni"
                    class="w-full px-3 py-2 rounded-xl bg-slate-50 border border-slate-200 text-xs focus:ring-2 focus:ring-sky-500 outline-none"
                />
            </div>
            <div>
                <label class="block font-bold text-slate-700 mb-1">Mobile Number *</label>
                <input
                    type="tel"
                    required
                    placeholder="+91 98220 XXXXX"
                    class="w-full px-3 py-2 rounded-xl bg-slate-50 border border-slate-200 text-xs focus:ring-2 focus:ring-sky-500 outline-none"
                />
            </div>
            <div>
                <label class="block font-bold text-slate-700 mb-1">Consultation Mode *</label>
                <select class="w-full px-3 py-2 rounded-xl bg-slate-50 border border-slate-200 text-xs focus:ring-2 focus:ring-sky-500 outline-none">
                    <option value="clinic">In-Clinic Consultation</option>
                    <option value="telehealth">Video Telehealth</option>
                </select>
            </div>
            <div>
                <label class="block font-bold text-slate-700 mb-1">Select Specialty *</label>
                <select class="w-full px-3 py-2 rounded-xl bg-slate-50 border border-slate-200 text-xs focus:ring-2 focus:ring-sky-500 outline-none">
                    {
                        specialties.map((spec) => (
                            <option value={spec}>{spec}</option>
                        ))
                    }
                </select>
            </div>
            <button
                type="submit"
                class="w-full py-2.5 rounded-xl bg-sky-600 hover:bg-sky-700 active:scale-95 text-white font-bold text-xs elevation-4 hover:elevation-6 active:translate-y-0 transition-all"
            >
                Submit Consultation Request
            </button>
        </form>

        <div id="mobile-success-message" class="hidden p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-center text-xs text-emerald-800 font-semibold">
            ✓ Request Received! Our medical assistant will call you shortly.
        </div>
    </div>

    <!-- Mobile Clinic Info Card -->
    <div class="rounded-2xl bg-slate-900 text-white p-4 elevation-6 text-xs">
        <h4 class="font-bold text-sm mb-2 text-white">Clinic Address & Hours</h4>
        <p class="text-slate-300 leading-snug">
            Suite 402, Metro Health Tower, North Main Rd, Koregaon Park, Pune.
        </p>
        <div class="mt-3 pt-2 border-t border-white/10 flex justify-between text-[11px] text-slate-400">
            <span>Mon–Sat: 8:30 AM – 7:30 PM</span>
            <span class="text-emerald-400 font-bold">Open Today</span>
        </div>
        <div class="mt-2.5 pt-2 border-t border-white/10">
            <a
                href="#mobile-location"
                class="w-full py-2 px-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-xs flex items-center justify-center gap-1.5 transition-colors text-center"
            >
                <span>📍 View Google Map & Directions</span>
                <span>→</span>
            </a>
        </div>
    </div>
</section>

<script>
    const dForm = document.getElementById("desktop-appointment-form");
    const dSuccess = document.getElementById("desktop-success-message");
    if (dForm && dSuccess) {
        dForm.addEventListener("submit", (e) => {
            e.preventDefault();
            dForm.classList.add("hidden");
            dSuccess.classList.remove("hidden");
        });
    }

    const mForm = document.getElementById("mobile-appointment-form");
    const mSuccess = document.getElementById("mobile-success-message");
    if (mForm && mSuccess) {
        mForm.addEventListener("submit", (e) => {
            e.preventDefault();
            mForm.classList.add("hidden");
            mSuccess.classList.remove("hidden");
        });
    }
</script>

