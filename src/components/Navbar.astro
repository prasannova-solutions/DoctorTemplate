---
interface Props {
    brandName?: string;
    designation?: string;
}

const { 
    brandName = "Dr. Deepali Patil",
    designation = "MD, FACP" 
} = Astro.props;

const navLinks = [
    { label: "Home", href: "/#hero" },
    { label: "Specialties", href: "/#specialties" },
    { label: "About", href: "/#about" },
    { label: "Care Model", href: "/#care-journey" },
    { label: "Blog", href: "/blog" },
    { label: "Patient Stories", href: "/#testimonials" },
    { label: "FAQ", href: "/#faq" },
    { label: "Contact", href: "/#contact" },
];
---

<header class="fixed top-3 inset-x-0 z-50 px-3">
    <div class="mx-auto max-w-6xl">
        <!-- Main Navbar Pill -->
        <nav
            class="rounded-full glass-pill elevation-8 px-4 sm:px-6 py-2 sm:py-2.5 transition-all duration-300 hover:elevation-12 hover:-translate-y-0.5"
            aria-label="Main Navigation"
        >
            <div class="flex items-center justify-between gap-4">
                <!-- Brand Logo & Doctor Identity -->
                <a href="/" class="flex items-center gap-2.5 group">
                    <div
                        class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-gradient-to-tr from-sky-600 via-sky-500 to-teal-400 flex items-center justify-center text-white shadow-md shadow-sky-600/25 group-hover:scale-105 transition-transform"
                    >
                        <!-- Medical Cross & Pulse Icon -->
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            class="w-5 h-5"
                        >
                            <path
                                d="M11 2a1 1 0 0 1 2 0v4.07a8.003 8.003 0 0 1 7.93 7.93H22a1 1 0 1 1 0 2h-1.07a8.003 8.003 0 0 1-7.93 7.93V22a1 1 0 1 1-2 0v-4.07A8.003 8.003 0 0 1 3.07 16H2a1 1 0 1 1 0-2h1.07A8.003 8.003 0 0 1 11 6.07V2zm-1 9H7a1 1 0 0 0 0 2h3v3a1 1 0 0 0 2 0v-3h3a1 1 0 0 0 0-2h-3v-3a1 1 0 0 0-2 0v3z"
                            ></path>
                        </svg>
                    </div>
                    <div class="flex flex-col">
                        <span
                            class="font-bold text-sm sm:text-base text-slate-800 tracking-tight leading-tight group-hover:text-sky-700 transition-colors"
                        >
                            {brandName}
                        </span>
                        <span class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-sky-600">
                            {designation} • Internal Medicine
                        </span>
                    </div>
                </a>

                <!-- Desktop Links -->
                <ul class="hidden lg:flex items-center gap-1">
                    {
                        navLinks.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    class="px-3 py-1.5 rounded-full text-xs font-medium text-slate-600 hover:text-sky-600 hover:bg-sky-50/80 transition-colors"
                                >
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>

                <!-- CTA & Mobile Toggle -->
                <div class="flex items-center gap-2 sm:gap-3">
                    <a
                        href="/#appointment"
                        class="hidden sm:inline-flex items-center justify-center gap-1.5 px-4 sm:px-5 py-2 rounded-full text-xs sm:text-sm font-semibold text-white bg-sky-600 hover:bg-sky-700 btn-elevated-primary"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        Book Consultation
                    </a>

                    <!-- Mobile Hamburger Button -->
                    <button
                        id="navbar-toggle"
                        type="button"
                        class="lg:hidden inline-flex items-center justify-center w-9 h-9 rounded-full text-slate-700 hover:bg-slate-100/80 transition-colors focus:outline-none"
                        aria-expanded="false"
                        aria-label="Toggle navigation menu"
                    >
                        <svg
                            id="navbar-icon-open"
                            class="w-5 h-5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
                            ></path>
                        </svg>
                        <svg
                            id="navbar-icon-close"
                            class="w-5 h-5 hidden"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </nav>

        <!-- Mobile Menu Dropdown Card -->
        <div
            id="mobile-menu"
            class="hidden lg:hidden mt-2 rounded-2xl glass-panel-elevated elevation-12 p-4 flex-col gap-1"
        >
            <div class="px-3.5 py-1.5 mb-1 border-b border-slate-100 flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Navigation</span>
                <span class="text-[11px] font-medium text-emerald-600 flex items-center gap-1">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Clinic Open Today
                </span>
            </div>
            {
                navLinks.map((link) => (
                    <a
                        href={link.href}
                        class="mobile-nav-link px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-700 hover:text-sky-600 hover:bg-sky-50/70 transition-colors"
                    >
                        {link.label}
                    </a>
                ))
            }
            <a
                href="/#appointment"
                class="mobile-nav-link mt-2 text-center py-2.5 rounded-xl text-sm font-semibold text-white bg-sky-600 hover:bg-sky-700 btn-elevated-primary flex items-center justify-center gap-2"
            >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                Book Consultation
            </a>
            <div class="mt-2 pt-2 border-t border-slate-100 flex items-center justify-between px-2 text-[11px] text-slate-500">
                <span>Emergency: <strong class="text-slate-800">(020) 2612-8800</strong></span>
                <span>Mon-Sat: 8am-7:30pm</span>
            </div>
        </div>
    </div>
</header>

<script>
    const toggleBtn = document.getElementById("navbar-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("navbar-icon-open");
    const iconClose = document.getElementById("navbar-icon-close");
    const mobileLinks = document.querySelectorAll(".mobile-nav-link");

    function setMenuState(open: boolean) {
        if (!toggleBtn || !mobileMenu || !iconOpen || !iconClose) return;

        toggleBtn.setAttribute("aria-expanded", String(open));
        mobileMenu.classList.toggle("hidden", !open);
        mobileMenu.classList.toggle("flex", open);
        iconOpen.classList.toggle("hidden", open);
        iconClose.classList.toggle("hidden", !open);
    }

    if (toggleBtn && mobileMenu && iconOpen && iconClose) {
        toggleBtn.addEventListener("click", () => {
            const isCurrentlyOpen =
                toggleBtn.getAttribute("aria-expanded") === "true";
            setMenuState(!isCurrentlyOpen);
        });

        // Close menu when clicking any nav link
        mobileLinks.forEach((link) => {
            link.addEventListener("click", () => {
                setMenuState(false);
            });
        });
    }
</script>
