---
// Trust.astro - Patient Reassurance & Trust Section
---

<!-- ================= DESKTOP TRUST SECTION ================= -->
<section id="trust" class="hidden md:block w-full px-4 py-8 relative z-20">
    <div class="mx-auto max-w-[1340px]">
        <div class="relative rounded-3xl glass-panel-elevated elevation-8 overflow-hidden bg-gradient-to-br from-white/95 via-sky-50/60 to-white/90 border border-white/90 p-8 lg:p-12 transition-all duration-300 hover:elevation-12">
            
            <!-- Ambient Atmospheric Glows -->
            <div class="absolute -top-12 -left-12 w-80 h-80 bg-sky-300/15 rounded-full blur-3xl pointer-events-none -z-10"></div>
            <div class="absolute -bottom-12 -right-12 w-80 h-80 bg-teal-200/20 rounded-full blur-3xl pointer-events-none -z-10"></div>

            <div class="grid grid-cols-12 gap-8 lg:gap-12 items-center">
                
                <!-- Left Column: Copy & Reassurance -->
                <div class="col-span-12 lg:col-span-7">
                    <!-- Eyebrow Badge -->
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-100/90 text-sky-800 text-xs font-bold uppercase tracking-wider mb-4">
                        <span class="w-2 h-2 rounded-full bg-sky-600 animate-pulse"></span>
                        Compassionate & Confidential Care
                    </div>

                    <!-- Heading with User's Exact Phrase -->
                    <h2 class="text-3xl lg:text-4xl xl:text-[42px] font-extrabold text-slate-900 tracking-tight leading-[1.18]">
                        You Don’t Have to <span class="bg-gradient-to-r from-sky-700 via-sky-600 to-teal-700 bg-clip-text text-transparent">Worry Alone.</span>
                    </h2>

                    <!-- Body with User's Exact Sentence -->
                    <p class="mt-4 text-base lg:text-lg text-slate-600 leading-relaxed font-normal">
                        Your health concerns matter to us. We’re here to listen carefully, explain your options, and provide care that feels simple, clear, and comfortable.
                    </p>

                    <!-- Prominent Highlight Quote Callout -->
                    <div class="mt-6 p-4 lg:p-5 rounded-2xl bg-gradient-to-r from-sky-50/90 via-teal-50/40 to-white/80 border-l-4 border-sky-600 elevation-1 glass-panel flex items-start gap-3.5">
                        <div class="w-9 h-9 rounded-xl bg-sky-600 text-white flex items-center justify-center flex-shrink-0 shadow-sm mt-0.5">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-base lg:text-lg font-bold text-slate-900 leading-snug">
                                One conversation can be the first step toward feeling better.
                            </p>
                            <p class="mt-1 text-xs text-slate-500 font-medium">
                                Direct, unhurried consultations with Dr. Deepali Patil • MD, FACP
                            </p>
                        </div>
                    </div>

                    <!-- 3 Micro-Trust Pillars -->
                    <div class="mt-6 grid grid-cols-3 gap-3">
                        <div class="p-3 rounded-xl bg-white/80 border border-slate-100 elevation-1">
                            <div class="flex items-center gap-1.5 text-sky-700 text-xs font-bold mb-0.5">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                </svg>
                                Dedicated Time
                            </div>
                            <span class="text-[11px] text-slate-500 font-medium">30+ min unhurried visits</span>
                        </div>
                        <div class="p-3 rounded-xl bg-white/80 border border-slate-100 elevation-1">
                            <div class="flex items-center gap-1.5 text-sky-700 text-xs font-bold mb-0.5">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                </svg>
                                Clear Guidance
                            </div>
                            <span class="text-[11px] text-slate-500 font-medium">Plain, jargon-free advice</span>
                        </div>
                        <div class="p-3 rounded-xl bg-white/80 border border-slate-100 elevation-1">
                            <div class="flex items-center gap-1.5 text-sky-700 text-xs font-bold mb-0.5">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                </svg>
                                Safe Space
                            </div>
                            <span class="text-[11px] text-slate-500 font-medium">100% confidential dialogue</span>
                        </div>
                    </div>

                    <!-- CTA Buttons -->
                    <div class="mt-7 flex items-center gap-4 flex-wrap">
                        <a
                            href="#appointment"
                            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-sky-600 hover:bg-sky-700 text-white font-bold text-sm btn-elevated-primary transition-all"
                        >
                            Schedule a Conversation
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </a>
                        <a
                            href="#about"
                            class="inline-flex items-center gap-2 px-5 py-3.5 rounded-full bg-white/90 hover:bg-white text-slate-700 font-semibold text-sm glass-pill border border-slate-200 transition-all"
                        >
                            Meet Dr. Deepali Patil
                        </a>
                    </div>
                </div>

                <!-- Right Column: Doctor-Patient Trust Photo -->
                <div class="col-span-12 lg:col-span-5">
                    <div class="relative group">
                        <!-- Ambient Glow behind Image -->
                        <div class="absolute -inset-2 bg-gradient-to-tr from-sky-400/25 via-teal-300/20 to-sky-200/15 rounded-[36px] blur-xl opacity-80 group-hover:opacity-100 transition duration-500 pointer-events-none"></div>

                        <!-- Image Container with 3D Border & Highlights -->
                        <div class="relative rounded-3xl overflow-hidden border-4 border-white shadow-2xl bg-slate-100 aspect-[4/3] lg:aspect-[4/3.2]">
                            <img
                                src="/trust/doctor-patient-trust.jpg"
                                alt="Compassionate doctor-patient consultation with Dr. Deepali Patil"
                                class="w-full h-full object-cover object-center group-hover:scale-102 transition-transform duration-500 ease-out"
                                loading="lazy"
                                decoding="async"
                                width="720"
                                height="540"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/65 via-slate-950/10 to-transparent"></div>

                            <!-- Top Right Glass Badge -->
                            <div class="absolute top-3.5 right-3.5 glass-panel-elevated elevation-4 px-3 py-1.5 rounded-full flex items-center gap-1.5 bg-white/95 backdrop-blur-md border border-white">
                                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                <span class="text-[11px] font-bold text-slate-800">Welcoming New Patients</span>
                            </div>

                            <!-- Bottom Glass Pedestal Overlay -->
                            <div class="absolute bottom-3.5 left-3.5 right-3.5 glass-panel-elevated elevation-6 p-3.5 rounded-2xl bg-white/95 backdrop-blur-md border border-white flex items-center justify-between">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-8 h-8 rounded-xl bg-sky-100 text-sky-700 flex items-center justify-center font-bold text-xs flex-shrink-0">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                                        </svg>
                                    </div>
                                    <div>
                                        <p class="text-xs font-bold text-slate-900 leading-tight">Empathetic Bedside Care</p>
                                        <p class="text-[11px] text-slate-500 font-medium">Dr. Deepali Patil, MD, FACP</p>
                                    </div>
                                </div>
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-sky-50 text-sky-700 border border-sky-100">
                                    In-Clinic
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- ================= MOBILE TRUST SECTION ================= -->
<section class="block md:hidden px-3 ">
    <div class="relative rounded-2xl glass-panel-elevated elevation-6 overflow-hidden bg-white/95 border border-white/90 p-4">
        
        <!-- Mobile Top Image Banner -->
        <div class="relative h-48 w-full rounded-xl overflow-hidden mb-4 shadow-sm bg-slate-100">
            <img
                src="/trust/doctor-patient-trust.jpg"
                alt="Compassionate doctor-patient consultation with Dr. Deepali Patil"
                class="w-full h-full object-cover object-center"
                loading="lazy"
                decoding="async"
                width="600"
                height="400"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-slate-950/20 to-transparent"></div>
            
            <!-- Floating badge on image -->
            <div class="absolute top-2.5 left-2.5 glass-pill elevation-2 px-2.5 py-1 rounded-full bg-white/90 backdrop-blur-md flex items-center gap-1.5">
               
            </div>

            <div class="absolute bottom-2.5 left-2.5 glass-pill elevation-2 px-2.5 py-1 rounded-full bg-white/90 backdrop-blur-md flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-[10px] font-bold text-slate-800">Safe & Confidential</span>
            </div>
        </div>

        <!-- Eyebrow Pill -->
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-sky-100 text-sky-800 text-[10px] font-bold uppercase tracking-wider mb-2">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-600"></span>
            We Are Here For You
        </div>

        <!-- Heading -->
        <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight leading-tight">
            You Don’t Have to <span class="text-sky-600">Worry Alone.</span>
        </h2>

        <!-- Body -->
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
            Your health concerns matter to us. We’re here to listen carefully, explain your options, and provide care that feels simple, clear, and comfortable.
        </p>

        <!-- Prominent Quote Callout Box -->
        <div class="mt-3.5 p-3 rounded-xl bg-gradient-to-r from-sky-50 to-teal-50/60 border-l-4 border-sky-600 elevation-1 flex items-start gap-2.5">
            <div class="w-6 h-6 rounded-lg bg-sky-600 text-white flex items-center justify-center flex-shrink-0 shadow-xs mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
            </div>
            <p class="text-xs font-bold text-slate-900 leading-snug">
                One conversation can be the first step toward feeling better.
            </p>
        </div>

        <!-- Mobile Trust Checklist -->
        <div class="mt-3 grid grid-cols-2 gap-1.5">
            <div class="flex items-center gap-1.5 text-[10px] font-medium text-slate-700 bg-slate-50 p-2 rounded-lg border border-slate-100">
                <span class="text-emerald-500 font-bold">✓</span>
                <span>No rushed visits</span>
            </div>
            <div class="flex items-center gap-1.5 text-[10px] font-medium text-slate-700 bg-slate-50 p-2 rounded-lg border border-slate-100">
                <span class="text-emerald-500 font-bold">✓</span>
                <span>Jargon-free answers</span>
            </div>
        </div>

        <!-- Mobile Full-Width CTA -->
        <div class="mt-4">
            <a
                href="#appointment"
                class="block w-full py-3 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-center font-bold text-xs btn-elevated-primary shadow-sm active:scale-[0.99] transition-all"
            >
                Schedule Your Conversation →
            </a>
        </div>
    </div>
</section>

