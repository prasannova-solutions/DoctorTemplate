---
// CareProcess.astro - The Patient Care Journey (The Mayo Model)
const steps = [
    {
        num: "01",
        title: "Comprehensive Clinical Evaluation",
        tag: "Initial Consultation",
        desc: "An unhurried 30–45 minute consultation dedicated to reviewing your complete health history, symptoms, lifestyle factors, and immediate wellness priorities.",
        highlights: ["In-depth history audit", "Vitals & physical examination", "Review of previous medical reports"],
    },
    {
        num: "02",
        title: "Targeted Diagnostic Workup",
        tag: "Precision Testing",
        desc: "Evidence-based laboratory profiling and diagnostic screenings to uncover underlying root causes rather than merely masking superficial symptoms.",
        highlights: ["Advanced metabolic & lipid panel", "Cardiac & inflammatory markers", "Hormonal & glycemic tracking"],
    },
    {
        num: "03",
        title: "Collaborative Care Plan",
        tag: "Custom Roadmap",
        desc: "Dr. Patil formulates a tailored medical strategy integrating targeted pharmacological management, medical nutrition therapy, and risk mitigation.",
        highlights: ["Personalized prescription guide", "Lifestyle & nutritional protocol", "Preventive risk reduction targets"],
    },
    {
        num: "04",
        title: "Continuous Monitoring & Telehealth",
        tag: "Long-Term Wellness",
        desc: "Ongoing health oversight with scheduled follow-ups, remote biomarker tracking, and fast communication for any questions between visits.",
        highlights: ["Scheduled progress reviews", "Telehealth video check-ins", "Long-term longevity metric updates"],
    },
];
---

<!-- ================= DESKTOP CARE PROCESS ================= -->
<section id="care-journey" class="hidden md:block w-full px-4 py-16">
    <div class="mx-auto max-w-[1340px]">
        <!-- Section Header -->
        <div class="text-center max-w-3xl mx-auto mb-14">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-100 text-sky-800 text-xs font-bold uppercase tracking-wider mb-3">
                <span class="w-2 h-2 rounded-full bg-sky-600"></span>
                The Clinical Care Pathway
            </div>
            <h2 class="text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
                How We Care For You, Step by Step
            </h2>
            <p class="mt-3 text-slate-600 text-base leading-relaxed">
                Modeled after the integrated patient journey at premier clinics: systematic, evidence-based, and focused on lasting health outcomes.
            </p>
        </div>

        <!-- 4 Step Horizontal Cards -->
        <div class="grid grid-cols-4 gap-6 relative">
            {
                steps.map((step, idx) => (
                    <div class="group relative rounded-3xl elevated-card p-6 flex flex-col justify-between">
                        <div>
                            <!-- Step Number Pill & Tag -->
                            <div class="flex items-center justify-between mb-4">
                                <span class="w-10 h-10 rounded-2xl bg-sky-50 group-hover:bg-sky-600 text-sky-700 group-hover:text-white flex items-center justify-center font-black text-base transition-colors duration-300 shadow-xs">
                                    {step.num}
                                </span>
                                <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600">
                                    {step.tag}
                                </span>
                            </div>

                            <h3 class="text-lg font-bold text-slate-900 group-hover:text-sky-700 transition-colors leading-snug">
                                {step.title}
                            </h3>

                            <p class="mt-2.5 text-xs text-slate-600 leading-relaxed">
                                {step.desc}
                            </p>
                        </div>

                        <!-- Highlights List -->
                        <div class="mt-5 pt-4 border-t border-slate-100">
                            <ul class="space-y-1.5 text-xs text-slate-600">
                                {
                                    step.highlights.map((item) => (
                                        <li class="flex items-center gap-1.5">
                                            <svg class="w-3.5 h-3.5 text-sky-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                            </svg>
                                            <span class="text-[11px]">{item}</span>
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>
                    </div>
                ))
            }
        </div>

        <!-- Bottom reassurance banner -->
        <div class="mt-10 rounded-2xl bg-gradient-to-r from-sky-900 via-sky-800 to-teal-900 text-white p-6 shadow-lg flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                </div>
                <div>
                    <h4 class="font-bold text-base">Have recent lab reports or an unresolved medical query?</h4>
                    <p class="text-xs text-sky-200 mt-0.5">Bring prior records for comprehensive review or second opinion during your consultation.</p>
                </div>
            </div>
            <a
                href="#appointment"
                class="px-5 py-2.5 rounded-full bg-white text-sky-900 hover:bg-sky-50 font-bold text-xs shadow-md transition-all whitespace-nowrap"
            >
                Book Your First Visit
            </a>
        </div>
    </div>
</section>

<!-- ================= MOBILE CARE PROCESS ================= -->
<section class="block md:hidden px-3 py-10">
    <div class="mb-6">
        <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-sky-100 text-sky-800 text-[10px] font-bold uppercase tracking-wider mb-2">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-600"></span>
            Patient Journey
        </div>
        <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight leading-tight">
            How Your Care <br /><span class="text-sky-600">Works With Dr. Patil</span>
        </h2>
        <p class="mt-1 text-xs text-slate-600">
            A 4-step personalized roadmap to restore vitality and prevent disease.
        </p>
    </div>

    <!-- Vertical Stepper for Mobile -->
    <div class="space-y-3 relative before:absolute before:left-4 before:top-4 before:bottom-4 before:w-0.5 before:bg-sky-200">
        {
            steps.map((step) => (
                <div class="relative pl-10">
                    <!-- Circle number -->
                    <div class="absolute left-0 top-1 w-8 h-8 rounded-full bg-sky-600 text-white flex items-center justify-center font-bold text-xs shadow-sm ring-4 ring-white">
                        {step.num}
                    </div>

                    <div class="rounded-2xl glass-panel elevation-2 p-4">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-sky-700">{step.tag}</span>
                        <h3 class="text-sm font-bold text-slate-900 mt-0.5">{step.title}</h3>
                        <p class="mt-1 text-xs text-slate-600 leading-snug">{step.desc}</p>
                    </div>
                </div>
            ))
        }
    </div>

    <!-- Mobile Banner -->
    <div class="mt-5 p-4 rounded-xl bg-sky-900 text-white text-center">
        <p class="text-xs font-bold">Need an immediate diagnostic review?</p>
        <p class="text-[11px] text-sky-200 mt-0.5 mb-3">Both in-person and telehealth slots available this week.</p>
        <a
            href="#appointment"
            class="inline-block w-full py-2 rounded-lg bg-white text-sky-900 font-bold text-xs"
        >
            Schedule Consultation
        </a>
    </div>
</section>

