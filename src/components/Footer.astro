---
// Footer.astro - Medical Practice Footer with Legal & Medical Disclaimers
const navLinks = [
    { label: "Home", href: "#hero" },
    { label: "Clinical Specialties", href: "#specialties" },
    { label: "About Dr. Patil", href: "#about" },
    { label: "Care Journey", href: "#care-journey" },
    { label: "Patient Stories", href: "#testimonials" },
    { label: "Clinic Location & Map", href: "#location" },
    { label: "Patient FAQ", href: "#faq" },
    { label: "Book Consultation", href: "#appointment" },
];

const clinicalDepartments = [
    "Internal & Preventive Medicine",
    "Cardiovascular Risk Mitigation",
    "Diabetes & Endocrinology",
    "Women's Hormonal Health",
    "Pulmonology & Respiratory Care",
    "Diagnostic Lab Screening",
    "Second Medical Opinion",
];
---

<!-- ================= DESKTOP FOOTER ================= -->
<footer id="contact" class="hidden md:block w-full bg-slate-900 text-slate-300 pt-16 pb-8 border-t border-slate-800">
    <div class="mx-auto max-w-[1340px] px-4">
        <!-- Main 4 Column Grid -->
        <div class="grid grid-cols-12 gap-10 pb-12 border-b border-slate-800">
            
            <!-- Col 1: Identity & Ethos (4 cols) -->
            <div class="col-span-4">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-sky-500 to-teal-400 flex items-center justify-center text-white font-bold shadow-md shadow-sky-500/20">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                            <path d="M11 2a1 1 0 0 1 2 0v4.07a8.003 8.003 0 0 1 7.93 7.93H22a1 1 0 1 1 0 2h-1.07a8.003 8.003 0 0 1-7.93 7.93V22a1 1 0 1 1-2 0v-4.07A8.003 8.003 0 0 1 3.07 16H2a1 1 0 1 1 0-2h1.07A8.003 8.003 0 0 1 11 6.07V2zm-1 9H7a1 1 0 0 0 0 2h3v3a1 1 0 0 0 2 0v-3h3a1 1 0 0 0 0-2h-3v-3a1 1 0 0 0-2 0v3z"></path>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-white tracking-tight">Dr. Deepali Patil</h3>
                        <p class="text-xs text-sky-400 font-semibold uppercase tracking-wider">MD, FACP • Internal Medicine</p>
                    </div>
                </div>

                <p class="text-xs text-slate-400 leading-relaxed pr-6">
                    A premier medical practice modeled after world-class clinical standards like Mayo Clinic. Dedicated to diagnostic accuracy, chronic disease mitigation, and whole-person wellness.
                </p>

                <!-- Accreditations row -->
                <div class="mt-6 flex items-center gap-2">
                    <span class="text-[10px] font-bold px-2 py-1 rounded bg-slate-800 text-slate-300 border border-slate-700">Board Certified</span>
                    <span class="text-[10px] font-bold px-2 py-1 rounded bg-slate-800 text-slate-300 border border-slate-700">Fellow ACP</span>
                    <span class="text-[10px] font-bold px-2 py-1 rounded bg-slate-800 text-slate-300 border border-slate-700">IMA Life Member</span>
                </div>
            </div>

            <!-- Col 2: Specialties (3 cols) -->
            <div class="col-span-3">
                <h4 class="text-xs font-bold uppercase tracking-wider text-white mb-4">Clinical Specialties</h4>
                <ul class="space-y-2 text-xs">
                    {
                        clinicalDepartments.map((dept) => (
                            <li>
                                <a href="#specialties" class="text-slate-400 hover:text-sky-400 transition-colors">
                                    {dept}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Col 3: Navigation (2 cols) -->
            <div class="col-span-2">
                <h4 class="text-xs font-bold uppercase tracking-wider text-white mb-4">Patient Links</h4>
                <ul class="space-y-2 text-xs">
                    {
                        navLinks.map((link) => (
                            <li>
                                <a href={link.href} class="text-slate-400 hover:text-sky-400 transition-colors">
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Col 4: Clinic Info & Hours (3 cols) -->
            <div class="col-span-3">
                <h4 class="text-xs font-bold uppercase tracking-wider text-white mb-4">Clinic & Hours</h4>
                <p class="text-xs text-slate-300 font-medium">Patil Healthcare & Specialty Center</p>
                <p class="text-xs text-slate-400 mt-1">Suite 402, Metro Health Tower, Koregaon Park, Pune, MH 411001</p>

                <div class="mt-4 space-y-1 text-xs text-slate-400">
                    <p><strong class="text-slate-200">Helpline:</strong> (020) 2612-8800</p>
                    <p><strong class="text-slate-200">Direct:</strong> +91 98220 12345</p>
                    <p><strong class="text-slate-200">Hours:</strong> Mon – Sat: 8:30 AM – 7:30 PM</p>
                    <p class="pt-1"><a href="#location" class="text-sky-400 hover:underline font-semibold">📍 View Google Map & Directions →</a></p>
                </div>

                <div class="mt-4 flex gap-2">
                    <a
                        href="#appointment"
                        class="inline-block px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 active:scale-95 text-white font-bold text-xs elevation-4 hover:elevation-8 hover:-translate-y-0.5 active:translate-y-0 transition-all"
                    >
                        Schedule Online
                    </a>
                </div>
            </div>

        </div>

        <!-- Medical Disclaimer Banner (Mayo Clinic standard) -->
        <div class="py-6 border-b border-slate-800 text-[11px] text-slate-500 leading-relaxed">
            <strong class="text-slate-400">Medical Disclaimer:</strong> The information presented on this website is for informational and educational purposes only and does not substitute professional medical diagnosis, advice, or treatment. Always consult Dr. Deepali Patil or another qualified healthcare provider regarding your health conditions. If you are experiencing a medical emergency, call your local emergency department immediately.
        </div>

        <!-- Copyright & Credits -->
        <div class="pt-6 flex items-center justify-between text-xs text-slate-500">
            <p>© 2026 Dr. Deepali Patil, MD, FACP. All rights reserved.</p>
            <p class="flex items-center gap-4">
                <a href="#about" class="hover:text-slate-300">Privacy Practices</a>
                <span>•</span>
                <a href="#about" class="hover:text-slate-300">Terms of Care</a>
                <span>•</span>
                <a href="#about" class="hover:text-slate-300">Patient Rights</a>
            </p>
        </div>
    </div>
</footer>

<!-- ================= MOBILE FOOTER ================= -->
<footer class="block md:hidden bg-slate-900 text-slate-300 px-4 pt-10 pb-6 border-t border-slate-800">
    <div class="flex items-center gap-2.5 mb-3">
        <div class="w-8 h-8 rounded-full bg-sky-600 flex items-center justify-center text-white font-bold text-xs">
            DP
        </div>
        <div>
            <h4 class="text-sm font-bold text-white">Dr. Deepali Patil</h4>
            <p class="text-[10px] text-sky-400 font-semibold uppercase">MD, FACP • Internal Medicine</p>
        </div>
    </div>

    <p class="text-[11px] text-slate-400 leading-relaxed mb-4">
        Evidence-based medical care, diagnostic evaluations, and chronic disease management.
    </p>

    <div class="p-3 rounded-xl bg-slate-800/80 border border-slate-700 text-xs mb-4">
        <p class="font-bold text-white mb-1">Clinic Address:</p>
        <p class="text-slate-300 text-[11px]">Suite 402, Metro Health Tower, Koregaon Park, Pune</p>
        <div class="mt-2 pt-2 border-t border-slate-700/60 flex items-center justify-between text-[11px]">
            <a href="tel:+912026128800" class="text-sky-400 font-bold">Call Clinic</a>
            <span class="text-slate-400">8:30am - 7:30pm</span>
            <a href="#mobile-location" class="text-teal-400 font-bold">📍 Google Map</a>
        </div>
    </div>

    <!-- Medical Disclaimer for Mobile -->
    <div class="text-[10px] text-slate-500 leading-snug border-t border-slate-800 pt-3">
        <strong>Medical Disclaimer:</strong> For educational purposes only. Does not replace formal medical evaluation. In an emergency, contact emergency medical services immediately.
    </div>

    <p class="text-[10px] text-slate-600 text-center mt-4">
        © 2026 Dr. Deepali Patil, MD. All rights reserved.
    </p>
</footer>

