---
// Specialties.astro - Clinical Specialties & Medical Departments
const specialties = [
    {
        id: "internal-medicine",
        badge: "Core Specialty",
        title: "Internal & Preventive Medicine",
        subtitle: "Diagnostic Excellence & Longevity",
        desc: "Comprehensive whole-person health evaluations, unexplained multi-symptom diagnoses, adult immunizations, and executive longevity assessments modeled after top clinical institutions.",
        conditions: ["Executive Health", "Chronic Fatigue", "Multi-System Diagnostics", "Preventive Screenings"],
        image: "/specialties/internal-medicine.jpg",
        icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
        color: "sky",
    },
    {
        id: "cardiovascular",
        badge: "Cardiovascular Care",
        title: "Cardiovascular & Metabolic Care",
        subtitle: "Heart Health & Risk Mitigation",
        desc: "Advanced screening and medical therapy for hypertension, dyslipidemia, coronary risk stratification, and preventive lifestyle modifications to protect heart and arterial vitality.",
        conditions: ["Hypertension", "Cholesterol / Dyslipidemia", "ECG Review", "Vascular Protection"],
        image: "/specialties/cardiovascular.jpg",
        icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />`,
        color: "rose",
    },
    {
        id: "endocrinology",
        badge: "Metabolic Health",
        title: "Diabetes & Endocrinology",
        subtitle: "Glycemic Balance & Hormone Health",
        desc: "Holistic care plans for Type 2 Diabetes, prediabetes reversal, continuous glucose monitoring (CGM) integration, and medical thyroid management (hypo/hyperthyroidism).",
        conditions: ["Type 2 Diabetes", "Prediabetes Reversal", "Thyroid Disorders", "Metabolic Syndrome"],
        image: "/specialties/endocrinology.jpg",
        icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />`,
        color: "amber",
    },
    {
        id: "womens-health",
        badge: "Women's Wellness",
        title: "Women's Health & Preventive Oncology",
        subtitle: "Comprehensive Care Across Lifespans",
        desc: "Dedicated clinical consultations focused on hormonal transitions, perimenopause, bone mineral density assessment (osteopenia/osteoporosis), and cancer risk screenings.",
        conditions: ["Hormone Balancing", "Bone Health & Osteoporosis", "Cancer Risk Profiling", "Preventive Wellness"],
        image: "/specialties/womens-health.jpg",
        icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />`,
        color: "purple",
    },
    {
        id: "pulmonology",
        badge: "Respiratory Health",
        title: "Pulmonology & Respiratory Care",
        subtitle: "Breath & Airway Management",
        desc: "Thorough diagnostic and medical management for chronic cough, asthma, bronchitis, environmental allergies, and post-viral pulmonary recovery protocols.",
        conditions: ["Bronchial Asthma", "Chronic Cough Workup", "Allergic Rhinitis", "Pulmonary Health"],
        image: "/specialties/pulmonology.jpg",
        icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />`,
        color: "teal",
    },
    {
        id: "diagnostics",
        badge: "Clinical Diagnostics",
        title: "Diagnostic Lab & Health Screenings",
        subtitle: "Precise Biomarkers & Fast Results",
        desc: "In-clinic blood diagnostics, comprehensive metabolic panels, organ function testing, and swift coordination with top medical imaging facilities.",
        conditions: ["Lipid & HbA1c Panels", "Liver & Renal Panels", "Vitamin & Mineral Profiles", "Inflammatory Biomarkers"],
        image: "/specialties/diagnostics.jpg",
        icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />`,
        color: "indigo",
    },
];
---

<!-- ================= DESKTOP SPECIALTIES SECTION ================= -->
<section id="specialties" class="hidden md:block w-full px-4 py-16">
    <div class="mx-auto max-w-[1340px]">
        <!-- Section Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
            <div class="max-w-2xl">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-100/80 text-sky-800 text-xs font-bold uppercase tracking-wider mb-3">
                    <span class="w-2 h-2 rounded-full bg-sky-600"></span>
                    Clinical Departments & Expertise
                </div>
                <h2 class="text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
                    Specialized Medical Care,
                    <br />
                    <span class="text-sky-600">Tailored to Your Unique Health Profile</span>
                </h2>
                <p class="mt-4 text-slate-600 text-base leading-relaxed">
                    Following the collaborative multidisciplinary philosophy inspired by institutions like Mayo Clinic, Dr. Deepali Patil provides thorough, evidence-based care across key medical disciplines.
                </p>
            </div>

            <div class="flex items-center gap-4">
                <!-- Physician Badge -->
                <div class="hidden lg:flex items-center gap-3 px-4 py-2 rounded-2xl glass-panel-elevated">
                    <img 
                        src="/Hero/DesktopHeroCutout.png" 
                        alt="Dr. Deepali Patil" 
                        class="w-11 h-11 rounded-full object-cover object-top border-2 border-white shadow-xs bg-sky-100"
                    />
                    <div>
                        <p class="text-xs font-bold text-slate-900 leading-tight">Dr. Deepali Patil, MD</p>
                        <p class="text-[11px] font-medium text-sky-600">Lead Specialty Consultant</p>
                    </div>
                </div>

                <a
                    href="#appointment"
                    class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-sky-600 hover:bg-sky-700 text-white font-semibold text-sm shadow-md shadow-sky-600/25 transition-all"
                >
                    Schedule a Consultation
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                </a>
            </div>
        </div>

        <!-- 3 Column Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {
                specialties.map((spec) => (
                    <div class="group relative rounded-3xl elevated-card overflow-hidden flex flex-col justify-between transition-[transform,box-shadow] duration-200">
                        <div>
                            <!-- Card Hero Image with Clean Specular Badges -->
                            <div class="relative h-48 w-full overflow-hidden bg-slate-100">
                                <img 
                                    src={spec.image} 
                                    alt={spec.title} 
                                    class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300 ease-out"
                                    loading="lazy"
                                    decoding="async"
                                    width="600"
                                    height="340"
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-slate-950/20 to-transparent"></div>
                                
                                <!-- Specular Badge on top left/right (zero nested blur for maximum 60fps performance) -->
                                <div class="absolute top-3.5 left-3.5 right-3.5 flex items-center justify-between pointer-events-none">
                                    <span class="text-[11px] font-bold px-3 py-1 rounded-full text-slate-900 bg-white/95 border border-white shadow-xs">
                                        {spec.badge}
                                    </span>
                                    <div class="w-9 h-9 rounded-xl bg-white/95 border border-white text-sky-700 flex items-center justify-center shadow-xs">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" set:html={spec.icon} />
                                    </div>
                                </div>
                                
                                <div class="absolute bottom-3 left-4 right-4">
                                    <p class="text-xs font-bold text-sky-200 uppercase tracking-wider drop-shadow-sm">
                                        {spec.subtitle}
                                    </p>
                                </div>
                            </div>

                            <!-- Content Area -->
                            <div class="p-6">
                                <h3 class="text-xl font-bold text-slate-900 group-hover:text-sky-600 transition-colors">
                                    {spec.title}
                                </h3>

                                <p class="mt-2.5 text-sm text-slate-600 leading-relaxed">
                                    {spec.desc}
                                </p>

                                <!-- Key Focus Chips -->
                                <div class="mt-4 pt-3 border-t border-slate-100">
                                    <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">
                                        Clinical Focus:
                                    </p>
                                    <div class="flex flex-wrap gap-1.5">
                                        {
                                            spec.conditions.map((cond) => (
                                                <span class="text-xs px-2.5 py-1 rounded-lg bg-slate-50 text-slate-700 font-medium border border-slate-100">
                                                    {cond}
                                                </span>
                                            ))
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Link -->
                        <div class="px-6 pb-6 pt-2 border-t border-slate-100 flex items-center justify-between">
                            <a
                                href="#appointment"
                                class="inline-flex items-center gap-1.5 text-xs font-bold text-sky-600 hover:text-sky-800 transition-colors group-hover:translate-x-1 duration-200"
                            >
                                Book Care for this Specialty
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                                </svg>
                            </a>
                            <span class="text-slate-400 text-xs">• In-Clinic & Telehealth</span>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<!-- ================= MOBILE SPECIALTIES SECTION ================= -->
<section class="block md:hidden px-3 py-8 overflow-hidden">
    <!-- Header with Doctor Branding -->
    <div class="mb-4">
        <div class="flex items-center justify-between mb-2">
            <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-sky-100 text-sky-800 text-[10px] font-bold uppercase tracking-wider">
                <span class="w-1.5 h-1.5 rounded-full bg-sky-600"></span>
                Clinical Specialties
            </div>
            <!-- Swipe / Nav Hint with Arrow Buttons -->
            <div class="flex items-center gap-1.5">
                <button 
                    id="spec-prev-btn" 
                    aria-label="Previous specialty"
                    class="w-7 h-7 rounded-full glass-pill flex items-center justify-center text-slate-700 active:scale-95 transition-all shadow-xs"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>
                <button 
                    id="spec-next-btn" 
                    aria-label="Next specialty"
                    class="w-7 h-7 rounded-full glass-pill flex items-center justify-center text-slate-700 active:scale-95 transition-all shadow-xs"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>
        </div>
        
        <div class="flex items-center gap-3">
            <img 
                src="/Hero/MobileHeroCutout.png" 
                alt="Dr. Deepali Patil" 
                class="w-11 h-11 rounded-full object-cover object-top border-2 border-sky-300 shadow-xs bg-sky-50 flex-shrink-0"
            />
            <div>
                <h2 class="text-xl font-extrabold text-slate-900 tracking-tight leading-tight">
                    Specialized Care by <span class="text-sky-600">Dr. Patil</span>
                </h2>
                <p class="text-[11px] font-medium text-slate-500">MD, FACP • 6 Departments • Swipe to explore</p>
            </div>
        </div>
    </div>

    <!-- Quick Jump Category Tabs -->
    <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-3 pt-1 -mx-3 px-3">
        {
            specialties.map((spec, index) => (
                <button
                    data-spec-target={index}
                    class={`spec-tab-btn flex-shrink-0 text-[11px] font-bold px-3 py-1.5 rounded-full transition-all duration-200 border ${
                        index === 0 
                            ? "bg-sky-600 text-white border-sky-600 shadow-xs" 
                            : "bg-white/90 text-slate-700 border-slate-200/80 hover:bg-sky-50"
                    }`}
                >
                    {spec.badge}
                </button>
            ))
        }
    </div>

    <!-- Swipeable Horizontal Snap Carousel -->
    <div 
        id="specialties-carousel"
        class="flex overflow-x-auto snap-x snap-mandatory gap-3.5 pb-3 pt-1 -mx-3 px-3 no-scrollbar scroll-smooth"
    >
        {
            specialties.map((spec, idx) => (
                <div 
                    data-spec-card={idx}
                    class="w-[82vw] max-w-[310px] flex-shrink-0 snap-center rounded-2xl elevated-card overflow-hidden flex flex-col justify-between"
                >
                    <div>
                        <!-- Card Hero Image -->
                        <div class="relative h-40 w-full overflow-hidden bg-slate-100">
                            <img 
                                src={spec.image} 
                                alt={spec.title} 
                                class="w-full h-full object-cover object-center"
                                loading="lazy"
                                decoding="async"
                                width="500"
                                height="280"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-slate-950/20 to-transparent"></div>
                            
                            <!-- Badges on Image (zero nested blur for maximum 60fps performance) -->
                            <div class="absolute top-2.5 left-2.5 right-2.5 flex items-center justify-between pointer-events-none">
                                <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full text-slate-900 bg-white/95 border border-white shadow-xs">
                                    {spec.badge}
                                </span>
                                <div class="w-7 h-7 rounded-lg bg-white/95 border border-white text-sky-700 flex items-center justify-center shadow-xs">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" set:html={spec.icon} />
                                </div>
                            </div>
                            
                            <!-- Subtitle Overlay -->
                            <div class="absolute bottom-2.5 left-3 right-3">
                                <span class="text-[11px] font-semibold text-sky-200 drop-shadow-sm">
                                    {spec.subtitle}
                                </span>
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="p-4">
                            <h3 class="text-base font-bold text-slate-900 leading-snug">
                                {spec.title}
                            </h3>
                            <p class="text-xs text-slate-600 mt-1.5 leading-relaxed line-clamp-2">
                                {spec.desc}
                            </p>

                            <!-- Clinical Focus Tags -->
                            <div class="mt-3 pt-2.5 border-t border-slate-100 flex flex-wrap gap-1">
                                {
                                    spec.conditions.slice(0, 3).map((cond) => (
                                        <span class="text-[10px] font-medium px-2 py-0.5 rounded-md bg-slate-100/90 text-slate-700">
                                            {cond}
                                        </span>
                                    ))
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Bottom Action Link -->
                    <div class="p-4 pt-0">
                        <a
                            href="#appointment"
                            class="block w-full py-2.5 rounded-xl bg-gradient-to-r from-sky-600 to-sky-700 hover:from-sky-700 hover:to-sky-800 text-white text-center font-bold text-xs shadow-sm shadow-sky-600/20 active:scale-[0.99] transition-all"
                        >
                            Schedule for {spec.badge} →
                        </a>
                    </div>
                </div>
            ))
        }
    </div>

    <!-- Carousel Indicator Dots & Counter -->
    <div class="flex items-center justify-between px-1 mt-2">
        <span id="spec-counter" class="text-[11px] font-semibold text-slate-400">
            Card 1 of {specialties.length}
        </span>
        <div class="flex items-center gap-1.5" id="spec-dots">
            {
                specialties.map((_, i) => (
                    <button 
                        data-dot-index={i}
                        aria-label={`Go to slide ${i + 1}`}
                        class={`spec-dot h-1.5 rounded-full transition-all duration-300 ${
                            i === 0 ? "w-5 bg-sky-600" : "w-1.5 bg-slate-300"
                        }`}
                    />
                ))
            }
        </div>
    </div>
</section>

<!-- High-Performance Asynchronous IntersectionObserver Script -->
<script>
    function initSpecialtiesCarousel() {
        const carousel = document.getElementById("specialties-carousel");
        const prevBtn = document.getElementById("spec-prev-btn");
        const nextBtn = document.getElementById("spec-next-btn");
        const counter = document.getElementById("spec-counter");
        const dots = document.querySelectorAll(".spec-dot");
        const tabBtns = document.querySelectorAll(".spec-tab-btn");
        const cards = document.querySelectorAll("[data-spec-card]");

        if (!carousel || cards.length === 0) return;

        function updateActiveSlide(index: number) {
            if (counter) {
                counter.textContent = `Card ${index + 1} of ${cards.length}`;
            }

            dots.forEach((dot, idx) => {
                if (idx === index) {
                    dot.classList.add("w-5", "bg-sky-600");
                    dot.classList.remove("w-1.5", "bg-slate-300");
                } else {
                    dot.classList.remove("w-5", "bg-sky-600");
                    dot.classList.add("w-1.5", "bg-slate-300");
                }
            });

            tabBtns.forEach((btn, idx) => {
                if (idx === index) {
                    btn.className = "spec-tab-btn flex-shrink-0 text-[11px] font-bold px-3 py-1.5 rounded-full transition-all duration-200 border bg-sky-600 text-white border-sky-600 shadow-xs";
                    btn.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
                } else {
                    btn.className = "spec-tab-btn flex-shrink-0 text-[11px] font-bold px-3 py-1.5 rounded-full transition-all duration-200 border bg-white/90 text-slate-700 border-slate-200/80 hover:bg-sky-50";
                }
            });
        }

        function scrollToSlide(index: number) {
            if (cards[index]) {
                cards[index].scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
                updateActiveSlide(index);
            }
        }

        tabBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                const targetIdx = parseInt(btn.getAttribute("data-spec-target") || "0", 10);
                scrollToSlide(targetIdx);
            });
        });

        dots.forEach((dot) => {
            dot.addEventListener("click", () => {
                const dotIdx = parseInt(dot.getAttribute("data-dot-index") || "0", 10);
                scrollToSlide(dotIdx);
            });
        });

        let currentIdx = 0;
        prevBtn?.addEventListener("click", () => {
            currentIdx = Math.max(0, currentIdx - 1);
            scrollToSlide(currentIdx);
        });

        nextBtn?.addEventListener("click", () => {
            currentIdx = Math.min(cards.length - 1, currentIdx + 1);
            scrollToSlide(currentIdx);
        });

        // Zero-overhead native IntersectionObserver (runs off-main-thread)
        if ("IntersectionObserver" in window) {
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            const idx = parseInt(entry.target.getAttribute("data-spec-card") || "0", 10);
                            currentIdx = idx;
                            updateActiveSlide(idx);
                        }
                    });
                },
                { root: carousel, threshold: 0.6 }
            );

            cards.forEach((card) => observer.observe(card));
        }
    }

    initSpecialtiesCarousel();
    document.addEventListener("astro:page-load", initSpecialtiesCarousel);
</script>

